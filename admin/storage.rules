rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The admin portal already requires Firebase sign-in. Keep photo files
    // protected by that same access boundary instead of exposing them publicly.
    match /photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
