# BigQuery table created by the Google Cloud Standard usage cost export.
# Example: billing-project.billing_export.gcp_billing_export_v1_012345_ABCDEF_123456
BILLING_EXPORT_TABLE=

# Optional project used to run BigQuery jobs. Defaults to the Firebase project.
BILLING_QUERY_PROJECT=

# Optional dataset location such as US or asia-southeast1.
BILLING_DATASET_LOCATION=

# Optional display-only monthly budget used by the Reports progress bar.
MONTHLY_BUDGET=

# Optional comma-separated emergency/bootstrap administrator UIDs.
ADMIN_UIDS=
