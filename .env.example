# Firebase configuration placeholders for GradBook foundation
# Copy these values into each app's local .env file when the project is configured.

# Mobile app (Expo / React Native)
EXPO_PUBLIC_FIREBASE_API_KEY=your-mobile-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-mobile-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-mobile-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-mobile-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-mobile-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-mobile-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-mobile-measurement-id

# Admin app (React.js / Vite)
VITE_FIREBASE_API_KEY=your-admin-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-admin-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-admin-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-admin-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-admin-sender-id
VITE_FIREBASE_APP_ID=your-admin-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-admin-measurement-id
