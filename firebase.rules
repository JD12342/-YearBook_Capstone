rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveProfileRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function hasTokenRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdministrator() {
      return hasTokenRole('Administrator')
        || request.auth.token.admin == true
        || hasActiveProfileRole('Administrator');
    }

    function isStaff() {
      return hasTokenRole('Staff') || hasActiveProfileRole('Staff');
    }

    function canManage() {
      return isAdministrator() || isStaff();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || canManage());
      allow list: if canManage();
      allow create, update, delete: if isAdministrator();
    }

    match /accountRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['Student', 'Alumni', 'Staff']
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ]);
      allow get, list: if isAdministrator()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdministrator();
    }

    match /students/{studentId} {
      allow read, write: if canManage();
    }

    match /schoolYears/{schoolYearId} {
      allow read, write: if canManage();
    }

    match /strands/{strandId} {
      allow read, write: if canManage();
    }

    match /sections/{sectionId} {
      allow read, write: if canManage();
    }

    match /photos/{photoId} {
      allow read, write: if canManage();
    }

    match /yearbooks/{yearbookId} {
      allow read: if isSignedIn();
      allow write: if canManage();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if canManage();
    }

    match /alumni/{alumniId} {
      allow read: if isSignedIn();
      allow write: if canManage();
    }

    match /schoolContent/{contentId} {
      allow read: if isSignedIn();
      allow write: if canManage();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
