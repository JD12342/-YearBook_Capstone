rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveProfileRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function hasTokenRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isBootstrapAdministrator() {
      return isSignedIn() && request.auth.uid == 'iVLZld9fcpcPQXbat8jdlmN6AsC3';
    }

    function isAdministrator() {
      return isBootstrapAdministrator()
        || hasTokenRole('Administrator')
        || request.auth.token.admin == true
        || hasActiveProfileRole('Administrator');
    }

    function isUser() {
      return hasTokenRole('User') || hasActiveProfileRole('User');
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdministrator());
      allow list, create, update, delete: if isAdministrator();
    }

    match /accountRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'User'
        && request.resource.data.profileType in ['Student', 'Teacher', 'Staff']
        && request.resource.data.referenceId is string
        && request.resource.data.referenceId.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'role', 'profileType', 'referenceId',
          'status', 'createdAt', 'updatedAt'
        ]);
      allow get, list: if isAdministrator()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdministrator();
    }

    match /students/{studentId} {
      allow read, write: if isAdministrator();
    }

    match /schoolYears/{schoolYearId} {
      allow read, write: if isAdministrator();
    }

    match /strands/{strandId} {
      allow read, write: if isAdministrator();
    }

    match /sections/{sectionId} {
      allow read, write: if isAdministrator();
    }

    match /photos/{photoId} {
      allow read, write: if isAdministrator();
    }

    match /yearbooks/{yearbookId} {
      allow read: if isAdministrator()
        || (isUser() && resource.data.status == 'active');
      allow write: if isAdministrator();
    }

    match /announcements/{announcementId} {
      allow read: if isAdministrator()
        || (isUser() && resource.data.status == 'published');
      allow write: if isAdministrator();
    }

    match /alumni/{alumniId} {
      allow read: if isAdministrator()
        || (isUser() && resource.data.status == 'active');
      allow write: if isAdministrator();
    }

    match /schoolContent/{contentId} {
      allow read: if isAdministrator()
        || (isUser() && resource.data.status == 'published');
      allow write: if isAdministrator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
