rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveProfileRole(role) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdministrator() {
      return isSignedIn() && (
        request.auth.uid == 'iVLZld9fcpcPQXbat8jdlmN6AsC3'
        || request.auth.token.role == 'Administrator'
        || request.auth.token.admin == true
        || hasActiveProfileRole('Administrator')
      );
    }

    function canViewCommunity() {
      return isAdministrator()
        || (isSignedIn() && (
          request.auth.token.role == 'User'
          || hasActiveProfileRole('User')
        ));
    }

    function canViewYearbook(yearbookId) {
      return isAdministrator()
        || (canViewCommunity()
          && firestore.exists(/databases/(default)/documents/yearbooks/$(yearbookId))
          && firestore.get(/databases/(default)/documents/yearbooks/$(yearbookId)).data.status == 'active');
    }

    // Original camera captures are private to administrators.
    match /photos/{allPaths=**} {
      allow read, delete: if isAdministrator();
      allow create, update: if isAdministrator()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The editor writes the final approved crop here. Community users can read
    // only this published version; administrators retain all write controls.
    match /photos/{schoolYearId}/{strandId}/{studentId}/approved/{fileName} {
      allow read: if canViewCommunity();
      allow create, update: if isAdministrator()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdministrator();
    }

    match /published/{allPaths=**} {
      allow read: if canViewCommunity();
      allow create, update: if isAdministrator()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdministrator();
    }

    match /yearbooks/{yearbookId}/{allPaths=**} {
      allow read: if canViewYearbook(yearbookId);
      allow create, update: if isAdministrator()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio)/.*');
      allow delete: if isAdministrator();
    }

    function canViewPublishedContent(collectionName, recordId) {
      return canViewCommunity()
        && collectionName in ['announcements', 'alumni', 'schoolContent']
        && firestore.exists(/databases/(default)/documents/$(collectionName)/$(recordId))
        && firestore.get(/databases/(default)/documents/$(collectionName)/$(recordId)).data.status in ['published', 'active'];
    }

    match /content/{collectionName}/{recordId}/{fileName} {
      allow read: if isAdministrator() || canViewPublishedContent(collectionName, recordId);
      allow create, update: if isAdministrator()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdministrator();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
