rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveProfileRole(role) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdministrator() {
      return isSignedIn() && (
        request.auth.uid == 'iVLZld9fcpcPQXbat8jdlmN6AsC3'
        || request.auth.token.role == 'Administrator'
        || request.auth.token.admin == true
        || hasActiveProfileRole('Administrator')
      );
    }

    function canViewCommunity() {
      return isAdministrator()
        || (isSignedIn() && (
          request.auth.token.role == 'User'
          || hasActiveProfileRole('User')
        ));
    }

    match /photos/{allPaths=**} {
      allow read, delete: if isAdministrator();
      allow create, update: if isAdministrator()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /published/{allPaths=**} {
      allow read: if canViewCommunity();
      allow create, update: if isAdministrator()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdministrator();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
